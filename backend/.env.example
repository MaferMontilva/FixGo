# =========================================================
# Variables de entorno del backend (FixGo IA)
# Copia este archivo como  backend/.env  y ajusta los valores.
# =========================================================

# --- Base de datos (SQLite) ---
# La base ya viene incluida en backend/database/fixgo.db con datos de demostración.
DATABASE_URL="file:../database/fixgo.db"

# --- Autenticación (OBLIGATORIO) ---
# Define un secreto propio, largo y aleatorio. Sin él, el backend no arranca.
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Servidor ---
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# --- Inteligencia artificial (OPCIONAL) ---
# Si no configuras ninguna clave, la IA funciona con el respaldo local basado en reglas.
# Proveedor preferido: groq | gemini | openai (si se omite, se autodetecta por las claves).
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=
